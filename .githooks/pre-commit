#!/bin/sh

set -eu

project="OpenMissionControl.xcodeproj/project.pbxproj"
swift_format_config=".swift-format"

# Git normally invokes hooks from the repository root, but resolve it
# explicitly so this hook also works when it is run manually.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [ ! -f "$project" ]; then
    echo "pre-commit: cannot find $project" >&2
    exit 1
fi

# Staging the whole project file below must not sweep unrelated edits into the
# commit. Ask the developer to make an explicit staging decision first.
if ! git diff --quiet -- "$project"; then
    echo "pre-commit: $project has unstaged changes." >&2
    echo "Stage or stash them before committing." >&2
    exit 1
fi

# Format all Swift files selected for this commit in one parallel invocation.
# Refuse to format a file with unstaged changes so the formatter cannot stage
# unrelated edits.
staged_swift_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')"
if [ -n "$staged_swift_files" ]; then
    echo "$staged_swift_files" | while IFS= read -r file; do
        [ -n "$file" ] || continue
        if ! git diff --quiet -- "$file"; then
            echo "pre-commit: $file has unstaged changes." >&2
            echo "Stage or stash them before committing." >&2
            exit 1
        fi
    done

    if [ -f "$swift_format_config" ]; then
        git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift' |
            xargs -0 xcrun swift-format format \
                --in-place \
                -p \
                --configuration "$swift_format_config"
    else
        git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift' |
            xargs -0 xcrun swift-format format --in-place -p
    fi

    echo "$staged_swift_files" | while IFS= read -r file; do
        [ -n "$file" ] || continue
        git add -- "$file"
    done
fi

# agvtool updates CURRENT_PROJECT_VERSION for every target in the project.
xcrun agvtool next-version -all

# Update tracked paths only so Git does not accidentally add other files from
# the .xcodeproj directory.
git add --update -- "$project"
echo "pre-commit: formatted staged Swift files and incremented the build number"
